# Copy to .env and fill in. Never commit .env.

# Core
DATABASE_URI=postgres://photographer:photographer@localhost:5432/photographer
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Postgres (docker compose); must match DATABASE_URI
POSTGRES_USER=photographer
POSTGRES_PASSWORD=photographer
POSTGRES_DB=photographer

# First admin user (used only by `pnpm create-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 — leave ALL of these blank to store uploads on local disk (./media).
# For R2, R2_ENDPOINT looks like https://<account-id>.r2.cloudflarestorage.com and all five must be set.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket URL or custom domain, e.g. https://img.example.com
R2_PUBLIC_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=

# Cron
CRON_SECRET=

# Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# --- Production (docker-compose.yml / Coolify) ---
# Self-hosted Umami analytics (the umami service)
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Backups (scripts/backup-db.sh): a PRIVATE R2 bucket, separate from the public media bucket
BACKUP_BUCKET=
